# Skopiuj do .env.local (lokalnie) i ustaw te same zmienne w Vercel → Settings → Environment Variables.
# NIE commituj prawdziwych wartości do repozytorium.

# --- Adres strony (canonical, sitemap, Open Graph, dane strukturalne) ---
NEXT_PUBLIC_SITE_URL=https://www.maxime.com.pl

# --- Sanity CMS ---
NEXT_PUBLIC_SANITY_PROJECT_ID=
NEXT_PUBLIC_SANITY_DATASET=production
NEXT_PUBLIC_SANITY_API_VERSION=2026-03-20
# Sekret webhooka – natychmiastowe odświeżenie strony po publikacji w Studio (patrz README)
SANITY_REVALIDATE_SECRET=

# --- Google ---
# Google Analytics 4 – identyfikator strumienia danych (ładuje się tylko po zgodzie na cookies)
NEXT_PUBLIC_GA_ID=G-XXXXXXXXXX
# Google Search Console – sama wartość "content" z tagu weryfikacyjnego HTML
NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION=
# Bing Webmaster Tools (opcjonalnie) – wartość "content" z tagu msvalidate.01
NEXT_PUBLIC_BING_SITE_VERIFICATION=
# Link „Poproś o opinie” z Profilu Firmy w Google – pokazuje przycisk na /opinie
NEXT_PUBLIC_GOOGLE_REVIEW_URL=

# --- Formularz kontaktowy (Resend) ---
RESEND_API_KEY=
CONTACT_TO_EMAIL=kontakt@maxime.com.pl
# Po weryfikacji domeny w Resend, np. "Fundacja Maxime <formularz@maxime.com.pl>"
CONTACT_FROM_EMAIL=

# --- Newsletter (MailerLite) ---
MAILERLITE_API_KEY=
MAILERLITE_GROUP_ID=
